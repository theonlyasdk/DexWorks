<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Row: Title & Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/text_activity_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                tools:text="MainActivity" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_launch_activity"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="0dp"
                android:text="@string/action_launch_activity"
                android:textSize="12sp"
                app:cornerRadius="18dp"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Status Badges / Chips -->
        <LinearLayout
            android:id="@+id/chip_group_badges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_exported"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_intent_filter_container"
                android:backgroundTint="?attr/colorSecondaryContainer"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                tools:text="Exported" />

            <TextView
                android:id="@+id/chip_launcher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_intent_filter_container"
                android:backgroundTint="?attr/colorPrimaryContainer"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:text="@string/badge_launcher"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/chip_alias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_intent_filter_container"
                android:backgroundTint="?attr/colorTertiaryContainer"
                android:textColor="?attr/colorOnTertiaryContainer"
                android:text="@string/badge_alias"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Component Path Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_intent_filter_container"
            android:backgroundTint="?attr/colorSurfaceContainerHigh"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/text_activity_class_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="11.5sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textIsSelectable="true"
                tools:text="com.asdk.tools.dexworks.MainActivity" />
        </LinearLayout>

        <!-- Additional Properties (Launch mode, Target, Permissions) -->
        <TextView
            android:id="@+id/text_target_activity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorSecondary"
            android:visibility="gone"
            tools:text="Target: com.example.TargetActivity"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/text_launch_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:text="Launch Mode: singleTask"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/text_permission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_intent_filter_container"
            android:backgroundTint="?attr/colorErrorContainer"
            android:textColor="?attr/colorOnErrorContainer"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:visibility="gone"
            tools:text="Requires: android.permission.BIND_VOICE_INTERACTION"
            tools:visibility="visible" />

        <!-- Intent filter section -->
        <LinearLayout
            android:id="@+id/layout_intent_filters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_intent_filter_container"
            android:backgroundTint="?attr/colorSurfaceContainerHighest"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_intent_filters"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/text_intent_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textIsSelectable="true"
                tools:text="• android.intent.action.MAIN\n• android.intent.action.VIEW" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
