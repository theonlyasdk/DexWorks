<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- Main Viewport: Toolbar and Scrollable Parameters -->
    <LinearLayout
        android:id="@+id/layout_main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="@string/vibration_title" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_main"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/container_scroll_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:descendantFocusability="blocksDescendants"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="120dp">

                <!-- Capability Card -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Material3.CardView.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <!-- Motor Status -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/vibration_hardware_motor"
                                    android:textAppearance="?attr/textAppearanceLabelSmall"
                                    android:textColor="?attr/colorOnSurfaceVariant" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:id="@+id/icon_motor_status"
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:layout_marginEnd="4dp"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/ic_check_circle_rounded"
                                        app:tint="?attr/colorPrimary" />

                                    <TextView
                                        android:id="@+id/text_motor_status"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="?attr/textAppearanceBodyMedium"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textStyle="bold"
                                        tools:text="Available" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Amplitude Control -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/vibration_amplitude_control"
                                    android:textAppearance="?attr/textAppearanceLabelSmall"
                                    android:textColor="?attr/colorOnSurfaceVariant" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:id="@+id/icon_amplitude_status"
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:layout_marginEnd="4dp"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/ic_check_circle_rounded"
                                        app:tint="?attr/colorPrimary" />

                                    <TextView
                                        android:id="@+id/text_amplitude_status"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="?attr/textAppearanceBodyMedium"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textStyle="bold"
                                        tools:text="Supported" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Primitives -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/vibration_composition_primitives"
                                    android:textAppearance="?attr/textAppearanceLabelSmall"
                                    android:textColor="?attr/colorOnSurfaceVariant" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:id="@+id/icon_primitives_status"
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:layout_marginEnd="4dp"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/ic_check_circle_rounded"
                                        app:tint="?attr/colorPrimary" />

                                    <TextView
                                        android:id="@+id/text_primitives_status"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="?attr/textAppearanceBodyMedium"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textStyle="bold"
                                        tools:text="Supported" />
                                </LinearLayout>
                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Waveform Generator & Pattern Controls Card -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Material3.CardView.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/vibration_section_pattern"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <!-- Waveform Type Selector -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/vibration_waveform_type"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:scrollbars="none">

                            <com.google.android.material.button.MaterialButtonToggleGroup
                                android:id="@+id/toggle_waveform_mode"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:checkedButton="@id/btn_mode_discrete"
                                app:selectionRequired="true"
                                app:singleSelection="true">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_mode_discrete"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/vibration_type_discrete" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_mode_sine"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/vibration_type_sine" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_mode_square"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/vibration_type_square" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_mode_sawtooth"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/vibration_type_sawtooth" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_mode_triangle"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/vibration_type_triangle" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_mode_chirp"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/vibration_type_chirp" />

                            </com.google.android.material.button.MaterialButtonToggleGroup>
                        </HorizontalScrollView>

                        <!-- SECTION 1: Discrete Points Controls -->
                        <LinearLayout
                            android:id="@+id/layout_discrete_mode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/text_points_count"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:textAppearance="?attr/textAppearanceTitleSmall"
                                    android:textColor="?attr/colorOnSurface"
                                    tools:text="Points (3)" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_add_point"
                                    style="@style/Widget.Material3.Button.TonalButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/vibration_add_point" />
                            </LinearLayout>

                            <!-- Dynamic Points Container -->
                            <LinearLayout
                                android:id="@+id/container_points"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="vertical" />
                        </LinearLayout>

                        <!-- SECTION 2: Continuous Wave Controls (Sine, Square, Sawtooth, Triangle, Chirp) -->
                        <LinearLayout
                            android:id="@+id/layout_continuous_mode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/label_wave_amp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceLabelLarge"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                tools:text="Amplitude: 220" />

                            <com.google.android.material.slider.Slider
                                android:id="@+id/slider_wave_amp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/vibration_amplitude"
                                android:stepSize="5"
                                android:value="220"
                                android:valueFrom="0"
                                android:valueTo="255" />

                            <TextView
                                android:id="@+id/label_wave_freq"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:textAppearance="?attr/textAppearanceLabelLarge"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                tools:text="Frequency: 5 Hz" />

                            <com.google.android.material.slider.Slider
                                android:id="@+id/slider_wave_freq"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/vibration_frequency"
                                android:stepSize="1"
                                android:value="5"
                                android:valueFrom="1"
                                android:valueTo="30" />

                            <TextView
                                android:id="@+id/label_wave_duration"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:textAppearance="?attr/textAppearanceLabelLarge"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                tools:text="Total Duration: 2.0 s" />

                            <com.google.android.material.slider.Slider
                                android:id="@+id/slider_wave_duration"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/vibration_total_duration"
                                android:stepSize="250"
                                android:value="2000"
                                android:valueFrom="500"
                                android:valueTo="30000" />

                            <!-- Square Wave Duty Cycle -->
                            <LinearLayout
                                android:id="@+id/layout_duty_cycle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <TextView
                                    android:id="@+id/label_wave_duty"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="?attr/textAppearanceLabelLarge"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    tools:text="Duty Cycle: 50%" />

                                <com.google.android.material.slider.Slider
                                    android:id="@+id/slider_wave_duty"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:contentDescription="@string/vibration_duty_cycle"
                                    android:stepSize="5"
                                    android:value="50"
                                    android:valueFrom="10"
                                    android:valueTo="90" />
                            </LinearLayout>

                            <!-- Chirp End Frequency -->
                            <LinearLayout
                                android:id="@+id/layout_chirp_end"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <TextView
                                    android:id="@+id/label_chirp_end"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="?attr/textAppearanceLabelLarge"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    tools:text="End Frequency: 25 Hz" />

                                <com.google.android.material.slider.Slider
                                    android:id="@+id/slider_chirp_end"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:contentDescription="@string/vibration_chirp_end_freq"
                                    android:stepSize="1"
                                    android:value="25"
                                    android:valueFrom="5"
                                    android:valueTo="60" />
                            </LinearLayout>

                            <!-- Frequency LFO / Modulation Section -->
                            <com.google.android.material.card.MaterialCardView
                                style="@style/Widget.Material3.CardView.Filled"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="12dp">

                                    <com.google.android.material.materialswitch.MaterialSwitch
                                        android:id="@+id/switch_lfo"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/vibration_lfo_enable"
                                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                                    <LinearLayout
                                        android:id="@+id/layout_lfo_controls"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:orientation="vertical"
                                        android:visibility="gone">

                                        <com.google.android.material.button.MaterialButtonToggleGroup
                                            android:id="@+id/toggle_lfo_shape"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            app:checkedButton="@id/btn_lfo_ramp"
                                            app:selectionRequired="true"
                                            app:singleSelection="true">

                                            <com.google.android.material.button.MaterialButton
                                                android:id="@+id/btn_lfo_ramp"
                                                style="@style/Widget.Material3.Button.OutlinedButton"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="@string/vibration_lfo_shape_ramp" />

                                            <com.google.android.material.button.MaterialButton
                                                android:id="@+id/btn_lfo_sine"
                                                style="@style/Widget.Material3.Button.OutlinedButton"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="@string/vibration_lfo_shape_sine" />

                                        </com.google.android.material.button.MaterialButtonToggleGroup>

                                        <TextView
                                            android:id="@+id/label_lfo_depth"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="8dp"
                                            android:textAppearance="?attr/textAppearanceLabelMedium"
                                            android:textColor="?attr/colorOnSurfaceVariant"
                                            tools:text="Modulation Depth: +10 Hz" />

                                        <com.google.android.material.slider.Slider
                                            android:id="@+id/slider_lfo_depth"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:contentDescription="@string/vibration_lfo_depth"
                                            android:stepSize="1"
                                            android:value="10"
                                            android:valueFrom="1"
                                            android:valueTo="35" />

                                        <TextView
                                            android:id="@+id/label_lfo_rate"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="6dp"
                                            android:textAppearance="?attr/textAppearanceLabelMedium"
                                            android:textColor="?attr/colorOnSurfaceVariant"
                                            tools:text="LFO Rate: 1.0 Hz" />

                                        <com.google.android.material.slider.Slider
                                            android:id="@+id/slider_lfo_rate"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:contentDescription="@string/vibration_lfo_rate"
                                            android:stepSize="0.2"
                                            android:value="1.0"
                                            android:valueFrom="0.2"
                                            android:valueTo="5.0" />

                                    </LinearLayout>

                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>

                        <!-- Pattern Preview -->
                        <TextView
                            android:id="@+id/text_pattern_preview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="monospace"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="timings [0, 40, 60, 40] amplitudes [0, 220, 0, 220]" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Single Pulse Test Card -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Material3.CardView.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/vibration_section_single"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/label_single_duration"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="Duration: 200 ms" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/slider_single_duration"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/vibration_section_single"
                            android:stepSize="10"
                            android:value="200"
                            android:valueFrom="10"
                            android:valueTo="1000" />

                        <TextView
                            android:id="@+id/label_single_amplitude"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="Amplitude: 200" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/slider_single_amplitude"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/vibration_amplitude"
                            android:stepSize="5"
                            android:value="200"
                            android:valueFrom="0"
                            android:valueTo="255" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_vibrate"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/vibration_run" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Group 1: One-Shot Tests Card -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Material3.CardView.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/vibration_section_oneshots"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/vibration_oneshots_summary"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <!-- Connected Expressive List for One-Shots -->
                        <LinearLayout
                            android:id="@+id/container_oneshot_presets"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Group 2: Looping Rhythms Card -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Material3.CardView.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/vibration_section_looping_rhythms"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/vibration_looping_summary"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <!-- Connected Expressive List for Looping Rhythms -->
                        <LinearLayout
                            android:id="@+id/container_looping_presets"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Voice Responsive Vibration Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_voice_vibration"
                    style="@style/Widget.Material3.CardView.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/vibration_voice_title"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/vibration_voice_desc"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/label_voice_sensitivity"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/vibration_voice_sensitivity"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/label_voice_input_level"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/vibration_voice_input_level"
                                android:textAppearance="?attr/textAppearanceLabelMedium"
                                android:textColor="?attr/colorPrimary" />
                        </LinearLayout>

                        <com.google.android.material.slider.Slider
                            android:id="@+id/slider_voice_sensitivity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/vibration_voice_title"
                            android:stepSize="1"
                            android:value="3"
                            android:valueFrom="1"
                            android:valueTo="8" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_voice_level"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="12dp"
                            android:max="100"
                            android:progress="0"
                            app:indicatorColor="?attr/colorPrimary"
                            app:trackColor="?attr/colorSurfaceContainerHighest"
                            app:trackCornerRadius="3dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_voice_listen"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/vibration_voice_start"
                            app:icon="@drawable/ic_tool_vibrate" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

    <!-- Persistent Bottom Sheet Housing the Waveform Visualizer -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_sheet_visualizer"
        style="@style/Widget.Material3.CardView.Elevated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorSurfaceContainer"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp"
        app:behavior_fitToContents="true"
        app:behavior_hideable="false"
        app:behavior_peekHeight="96dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Drag Handle -->
            <com.google.android.material.bottomsheet.BottomSheetDragHandleView
                android:id="@+id/drag_handle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Action Buttons Row: Play/Stop and Loop/Stop equally spaced -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingBottom="10dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_play_waveform"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="@string/vibration_play" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_loop_waveform"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/vibration_loop" />
            </LinearLayout>

            <!-- Rounded Graph Container -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:cardCornerRadius="16dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <com.asdk.tools.dexworks.VibrationGraphView
                    android:id="@+id/graph_view"
                    android:layout_width="match_parent"
                    android:layout_height="220dp" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
