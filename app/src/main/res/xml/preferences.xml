<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/settings_cat_appearance" />

    <ListPreference
        app:defaultValue="system"
        app:dialogTitle="@string/settings_theme_dialog"
        app:entries="@array/theme_names"
        app:entryValues="@array/theme_values"
        app:key="theme"
        app:title="@string/settings_theme"
        app:useSimpleSummaryProvider="true" />

    <SwitchPreferenceCompat
        app:defaultValue="true"
        app:key="dynamic_color"
        app:summary="@string/settings_dynamic_color_summary"
        app:title="@string/settings_dynamic_color" />

    <PreferenceCategory app:title="@string/settings_cat_code" />

    <ListPreference
        app:defaultValue="normal"
        app:dialogTitle="@string/settings_text_size_dialog"
        app:entries="@array/code_size_names"
        app:entryValues="@array/code_size_values"
        app:key="code_size"
        app:title="@string/settings_text_size"
        app:useSimpleSummaryProvider="true" />

    <SwitchPreferenceCompat
        app:defaultValue="true"
        app:key="line_numbers"
        app:summary="@string/settings_line_numbers_summary"
        app:title="@string/settings_line_numbers" />

    <SwitchPreferenceCompat
        app:defaultValue="false"
        app:key="word_wrap"
        app:summary="@string/settings_word_wrap_summary"
        app:title="@string/settings_word_wrap" />

    <PreferenceCategory app:title="@string/settings_cat_browsing" />

    <ListPreference
        app:defaultValue="name"
        app:dialogTitle="@string/settings_app_sort_dialog"
        app:entries="@array/app_sort_names"
        app:entryValues="@array/app_sort_values"
        app:key="app_sort_type"
        app:title="@string/settings_app_sort"
        app:useSimpleSummaryProvider="true" />

    <SwitchPreferenceCompat
        app:defaultValue="true"
        app:key="app_sort_ascending"
        app:summary="@string/settings_app_sort_ascending_summary"
        app:title="@string/settings_app_sort_ascending" />

    <SwitchPreferenceCompat
        app:defaultValue="false"
        app:key="show_system_apps"
        app:summary="@string/settings_show_system_apps_summary"
        app:title="@string/settings_show_system_apps" />

    <SwitchPreferenceCompat
        app:defaultValue="true"
        app:key="apk_folders_first"
        app:summary="@string/settings_folders_first_summary"
        app:title="@string/settings_folders_first" />

    <PreferenceCategory app:title="@string/settings_cat_viewers" />

    <ListPreference
        app:defaultValue="4"
        app:dialogTitle="@string/settings_hex_page_dialog"
        app:entries="@array/hex_page_names"
        app:entryValues="@array/hex_page_values"
        app:key="hex_page_size"
        app:title="@string/settings_hex_page"
        app:useSimpleSummaryProvider="true" />

    <ListPreference
        app:defaultValue="2048"
        app:dialogTitle="@string/settings_image_size_dialog"
        app:entries="@array/image_size_names"
        app:entryValues="@array/image_size_values"
        app:key="image_max_size"
        app:title="@string/settings_image_size"
        app:useSimpleSummaryProvider="true" />

    <PreferenceCategory app:title="@string/settings_cat_saving" />

    <Preference
        app:key="remembered_save_location"
        app:title="@string/settings_saved_folder" />

    <Preference
        app:key="clear_cache"
        app:summary="@string/settings_clear_cache_summary"
        app:title="@string/settings_clear_cache" />

    <PreferenceCategory app:title="@string/settings_cat_notifications" />

    <SwitchPreferenceCompat
        app:defaultValue="true"
        app:key="notifications"
        app:summary="@string/settings_notifications_summary"
        app:title="@string/settings_notifications" />

    <PreferenceCategory app:title="@string/settings_cat_about" />

    <Preference
        app:key="about"
        app:title="@string/settings_about" />

</PreferenceScreen>
